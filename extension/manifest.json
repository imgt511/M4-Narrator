{
  "manifest_version": 3,
  "name": "M4 Narrator",
  "version": "2.1",
  "description": "Local M4-powered AI voice narrator.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "clipboardRead"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],
  "action": { "default_popup": "popup.html" },
  "icons": { "48": "icon.png" }
}